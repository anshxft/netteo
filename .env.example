# Mezo Mainnet Chain Configuration
NEXT_PUBLIC_CHAIN_ID=31612
NEXT_PUBLIC_MEZO_MAINNET_RPC_URL=https://mezo-mainnet.boar.network
NEXT_PUBLIC_MEZO_MAINNET_WSS_RPC_URL=wss://mezo-mainnet.boar.network
NEXT_PUBLIC_MEZO_MAINNET_EXPLORER_URL=https://explorer.mezo.org
NEXT_PUBLIC_CURRENCY_SYMBOL=BTC
NEXT_PUBLIC_CURRENCY_DECIMALS=18

# Settlement tokens are NOT configured here. Netteo settles only in the verified Mezo
# registry in src/lib/chain/tokens.ts (MUSD 18 dec, mUSDC 6 dec, mUSDT 6 dec), and
# src/lib/chain/tokens.test.ts re-checks every address and decimals against the chain.
#
# One SettlementKernel is deployed per token (via SettlementKernelFactory). A token is
# selectable in Live mode only once its kernel address is set below. 0x000...0 = not deployed.
NEXT_PUBLIC_SETTLEMENT_KERNEL_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSD=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSDC=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSDT=0x0000000000000000000000000000000000000000
# Block of the factory deployment; every kernel is created at or after it.
NEXT_PUBLIC_SETTLEMENT_KERNEL_DEPLOY_BLOCK=0
# Legacy single-kernel variable, read as the MUSD kernel when NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSD is unset.
# NEXT_PUBLIC_SETTLEMENT_KERNEL_ADDRESS=

# Supabase / Read Model (Public Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Only Secrets (Never expose to browser)
# Signs wallet session tokens for the API. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Without it, sign-in (and every private read) fails closed. Set it on your hosting provider too.
SESSION_SECRET=
# Optional: protects /api/indexer for an external scheduler. Vercel Cron sends CRON_SECRET automatically.
# The app also indexes on read, so a scheduler is not required.
INDEXER_CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/netteo
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=15000

# Private Deployment Key (Hardhat / Foundry deployer - server/CLI only)
DEPLOYER_PRIVATE_KEY=
