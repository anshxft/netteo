NEXT_PUBLIC_SETTLEMENT_KERNEL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MUSD_DECIMALS=18

# Supabase / Read Model (Public Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Only Secrets (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/netteo
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=15000

# Private Deployment Key (Hardhat / Foundry deployer - server/CLI only)
DEPLOYER_PRIVATE_KEY=
