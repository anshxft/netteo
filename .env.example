# Mezo Testnet Chain Configuration
NEXT_PUBLIC_CHAIN_ID=31611
NEXT_PUBLIC_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_WSS_RPC_URL=wss://rpc-ws.test.mezo.org
NEXT_PUBLIC_EXPLORER_URL=https://explorer.test.mezo.org
NEXT_PUBLIC_CURRENCY_SYMBOL=BTC
NEXT_PUBLIC_CURRENCY_DECIMALS=18

# Settlement Contracts (Canonical Mezo Testnet MUSD is 0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503)
