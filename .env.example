# Netteo environment. Copy to .env.local and fill in the Supabase and secret values.
# Every variable below is read by the code; nothing here is a placeholder for a feature that does not exist.

# --- Mezo Mainnet (chain 31612) ------------------------------------------------------------------
# Optional: your own RPC provider goes first; the other Mezo providers are used automatically as fallbacks.
# NEXT_PUBLIC_MEZO_MAINNET_RPC_URL=https://mezo-mainnet.boar.network
# NEXT_PUBLIC_MEZO_MAINNET_EXPLORER_URL=https://explorer.mezo.org

# Settlement tokens are not configured here. Netteo settles only in the verified registry in
# src/lib/chain/tokens.ts (MUSD 18 decimals, mUSDC and mUSDT 6 decimals), and tokens.test.ts re-checks every
# address and decimals against the chain.
#
# One SettlementKernel per token, created by the factory. These are the public v2 deployment (see DEPLOYMENTS.md),
# so the app works against Mezo Mainnet as soon as Supabase is configured. A token is selectable in Live mode only
# when its kernel address is set; 0x000...0 means "not deployed".
NEXT_PUBLIC_SETTLEMENT_KERNEL_FACTORY_ADDRESS=0x95e35305d466dF41EF35E02AA53F1e90Db759a45
NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSD=0x427Ff00c792252cC364Cb3240Dc26E6e7872340e
NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSDC=0xE229B3a2020FC19331E8A3e9662a2508fFF78020
NEXT_PUBLIC_SETTLEMENT_KERNEL_MUSDT=0xFecBE8a962F5C2628E877AA4C0C90C399549f18f
# Block of the factory deployment; the indexer starts here.
NEXT_PUBLIC_SETTLEMENT_KERNEL_DEPLOY_BLOCK=13193001

# --- Supabase (private claim ledger) ---------------------------------------------------------------
# Create a project, then run src/lib/db/schema.sql in its SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public key. It can only read the chain-derived projection tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side secrets (never expose to the browser; set them on your host too) -----------------
# Required. The API cannot reach the private tables without it and fails closed.
SUPABASE_SERVICE_ROLE_KEY=
# Required. Signs wallet session tokens; at least 32 random characters. Without it sign-in fails closed.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional. Protects /api/indexer for an external scheduler (Vercel Cron sends CRON_SECRET automatically).
# The app also indexes whenever cycles are loaded, so a scheduler is not required.
INDEXER_CRON_SECRET=
# Optional indexer tuning: first block to read, and how many blocks to wait before treating an event as final.
# INDEXER_START_BLOCK=
# INDEXER_CONFIRMATION_DEPTH=2

# Deploying contracts does not use an environment variable: import your key into Foundry's encrypted keystore
# (see "Deploy the contracts" in README.md). Do not put a private key in this file.
